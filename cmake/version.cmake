# Writes the build's version header (cmake -P, run on every build by the phantom_version target):
#   cmake -DSRC=<source dir> -DOUT=<build>/generated/phantomring_version.h -P cmake/version.cmake
#
# PHANTOMRING_RELEASE  the VERSION file (the one version source: CMake's project version, both DLLs, pr --version,
#                      the packages' BUILD.txt)
# PHANTOMRING_COMMIT   `git rev-parse --short=12 HEAD`, "-dirty" when tracked files differ from it; "unknown" outside a
#                      git checkout. $PHANTOMRING_COMMIT overrides it (a build from a source archive).
# The header is rewritten only when its text changes, so an unchanged commit rebuilds nothing.
if(NOT SRC OR NOT OUT)
	message(FATAL_ERROR "version.cmake: pass -DSRC=<source dir> -DOUT=<header>")
endif()

file(STRINGS "${SRC}/VERSION" release LIMIT_COUNT 1)
string(STRIP "${release}" release)
if(NOT release MATCHES "^[0-9]+\\.[0-9]+\\.[0-9]+(-[0-9A-Za-z.]+)?$")
	message(FATAL_ERROR "VERSION: '${release}' is not MAJOR.MINOR.PATCH[-PRERELEASE]")
endif()

if(DEFINED ENV{PHANTOMRING_COMMIT} AND NOT "$ENV{PHANTOMRING_COMMIT}" STREQUAL "")
	set(commit "$ENV{PHANTOMRING_COMMIT}")
else()
	set(commit "unknown")
	find_program(GIT git)
	if(GIT)
		execute_process(COMMAND "${GIT}" -C "${SRC}" rev-parse --short=12 HEAD
			OUTPUT_VARIABLE head RESULT_VARIABLE rc OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
		if(rc EQUAL 0 AND head)
			set(commit "${head}")
			# Tracked files only; a submodule counts when it points elsewhere, not for files inside it.
			execute_process(COMMAND "${GIT}" -C "${SRC}" status --porcelain --untracked-files=no --ignore-submodules=dirty
				OUTPUT_VARIABLE changes RESULT_VARIABLE rc2 OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
			if(NOT rc2 EQUAL 0)
				set(commit "${commit}-unknown")
			elseif(changes)
				set(commit "${commit}-dirty")
			endif()
		endif()
	endif()
endif()
if(NOT commit MATCHES "^[0-9A-Za-z._-]+$")
	message(FATAL_ERROR "version.cmake: commit '${commit}' has characters a C string or BUILD.txt can't take")
endif()

set(text "// Generated by cmake/version.cmake on every build: do not edit, do not commit.
#pragma once
#define PHANTOMRING_RELEASE \"${release}\"
#define PHANTOMRING_COMMIT \"${commit}\"
")
set(current "")
if(EXISTS "${OUT}")
	file(READ "${OUT}" current)
endif()
if(NOT current STREQUAL text)
	file(WRITE "${OUT}" "${text}")
endif()
